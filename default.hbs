<!DOCTYPE html>
<html lang="{{@site.locale}}">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{meta_title}}</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            background-color: #121513;
            color: #FFFFFF;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            line-height: 1.5;
            padding-bottom: 40px;
        }
        .container { max-width: 720px; margin: 0 auto; padding: 0 16px; }
        .site-header {
            padding: 32px 0 24px 0;
            display: flex;
            align-items: center;
            border-bottom: 1px solid #2A322C;
            margin-bottom: 24px;
        }
        .site-logo {
            max-height: 40px;
            width: auto;
            margin-right: 14px;
            display: inline-block;
            vertical-align: middle;
            border-radius: 8px;
        }
        .logo-badge {
            background-color: #a7dd00;
            color: #121513;
            font-weight: 800;
            font-size: 18px;
            padding: 6px 12px;
            border-radius: 10px;
            margin-right: 12px;
            text-decoration: none;
            display: inline-block;
        }
        .site-icon {
    height: 40px;
    width: auto;
    max-width: 120px;
    margin-right: 14px;
    display: inline-block;
    vertical-align: middle;
    object-fit: contain;
    border-radius: 0;
}
        .site-title {
            font-size: 22px;
            font-weight: 700;
            color: #a7dd00;
            letter-spacing: -0.5px;
            text-decoration: none;
        }
        .badge {
            display: inline-block;
            background-color: rgba(181, 244, 0, 0.15);
            color: #a7dd00;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            padding: 4px 10px;
            border-radius: 20px;
            letter-spacing: 0.5px;
            margin-bottom: 12px;
            border: 1px solid rgba(181, 244, 0, 0.3);
            text-decoration: none;
        }
        .card {
            background-color: #1E231F;
            border: 1px solid #2A322C;
            border-radius: 16px;
            padding: 24px;
            margin-bottom: 16px;
        }
        .card-hero {
            background: linear-gradient(180deg, #1E231F 0%, #171B18 100%);
            border-color: rgba(181, 244, 0, 0.25);
            padding: 28px;
        }
        .card-title {
            font-size: 20px;
            font-weight: 700;
            color: #FFFFFF;
            margin-bottom: 10px;
            line-height: 1.3;
        }
        .card-hero .card-title { font-size: 24px; }
        .card-text {
            font-size: 14px;
            color: #A0AAB0;
            margin-bottom: 18px;
            line-height: 1.5;
        }
        .btn {
            display: inline-block;
            background-color: #a7dd00;
            color: #121513;
            font-size: 13px;
            font-weight: 700;
            padding: 10px 18px;
            border-radius: 10px;
            text-decoration: none;
            transition: opacity 0.2s ease;
        }
        .btn:hover { opacity: 0.9; }
        .btn-secondary {
            background-color: transparent;
            color: #a7dd00;
            border: 1px solid #a7dd00;
        }
        .btn-secondary:hover { background-color: rgba(181, 244, 0, 0.1); }
        .bento-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            margin-bottom: 16px;
        }
        @media (max-width: 600px) {
            .bento-grid { grid-template-columns: 1fr; }
        }
        .site-footer {
            margin-top: 32px;
            padding-top: 24px;
            border-top: 1px solid #2A322C;
            text-align: center;
            font-size: 12px;
            color: #6C757D;
        }
        .site-footer a {
            color: #a7dd00;
            text-decoration: none;
            margin: 0 8px;
        }
    </style>
    {{ghost_head}}
</head>
<body class="{{body_class}}">
    <div class="container">
        <header class="site-header">
            <a href="{{@site.url}}" style="display: flex; align-items: center; text-decoration: none;">
                {{#if @site.icon}}
                    <img class="site-icon" src="{{@site.icon}}" alt="{{@site.title}}" />
                {{else}}
                    <span class="logo-badge">eq</span>
                {{/if}}
            </a>
            <a href="{{@site.url}}" class="site-title">{{@site.title}}</a>
        </header>

        <main>
            {{{body}}}
        </main>

        <footer class="site-footer">
            <p>{{@site.title}} • Boletín Interno Corporativo</p>
            <p style="margin-top: 8px;">
                <a href="{{@site.url}}">Intranet</a> | 
                <a href="{{@site.url}}">Soporte Técnico</a> | 
                <a href="{{@site.url}}">Capacitaciones</a>
            </p>
        </footer>
    </div>
    {{ghost_foot}}
</body>
</html>